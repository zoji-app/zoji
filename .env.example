# Copie para .env e ajuste se precisar.
#
# URL da API em desenvolvimento. Sem ela, o app em modo dev usa o servidor
# falso local (http://localhost:8080, ver dev-server/). No emulador Android,
# use http://10.0.2.2:8080. Builds de release sempre usam a produção.
# EXPO_PUBLIC_API_URL=http://localhost:8080

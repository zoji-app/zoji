    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.15",
    "@types/react": "~19.1.10",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "detox": "^20.13.5",
    "dotenv": "^16.4.7",
    "emoji-datasource": "^16.0.0",
    "emojibase-data": "^17.0.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "glob": "^10.4.5",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "lint-staged": "^15.2.2",
    "metro-config": "^0.84.6",
    "patch-package": "^8.0.1",
    "prettier": "^3.2.5",
    "typescript": "~5.9.2",
    "ws": "^8.21.3"
  },
  "overrides": {
    "shell-quote": "^1.9.0",
    "stream-json": "^3.5.0",
    "xml2js": "^0.6.2",
    "@xmldom/xmldom": "^0.8.10",
    "fast-uri": "^3.1.2",
    "lodash.pick": "4.4.0",
    "lodash.template": "4.5.0",
    "undici": "^6.20.0",
    "@expo/config-plugins": {
      "xml2js": "^0.6.2"
    },
    "native-base": {
      "lodash.pick": "4.4.0"
    },
    "expo-firebase-core": {
      "semver": "^7.5.3",
      "xml2js": "^0.6.2"
    },
    "react-native-vector-icons": {
      "lodash.pick": "4.4.0",
      "lodash.template": "4.5.0"
    },
    "tar": "^7.5.21",
    "postcss": "^8.5.23",
    "nanoid": "^3.3.18",
    "js-yaml": "^3.15.2",
    "brace-expansion": "^2.1.4",
    "@babel/runtime": "^7.28.0",
    "decode-uri-component": "^0.2.2",
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": ["eslint --fix", "prettier --write"],
    "*.{json,md}": ["prettier --write"]
  },
  "private": true,
  "license": "MPL-2.0"

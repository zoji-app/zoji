{
  "name": "zoji",
  "version": "1.0.12",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:prod": "expo start --no-dev --minify",
    "android": "expo run:android",
    "android:prod": "expo start --android --no-dev --minify",
    "ios": "expo run:ios",
    "ios:prod": "expo start --ios --no-dev --minify",
    "web": "expo start --web",
    "test": "jest",
    "test:only": "jest __tests__/**/*.test.js",
    "test:coverage": "jest __tests__/**/*.test.js --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "postinstall": "patch-package",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "quality": "npm run type-check && npm run lint && npm run format:check && npm run test:ci",
    "quality:fix": "npm run type-check && npm run lint:fix && npm run format && npm run test",
    "prebuild": "npm run quality",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "build:all": "eas build --platform all",
    "deploy:staging": "eas update --branch staging",
    "deploy:production": "eas update --branch production",
    "env:setup": "cp .env.example .env",
    "env:validate": "node -e \"console.log('Environment variables:'); Object.keys(process.env).filter(k => k.startsWith('EXPO_PUBLIC_')).forEach(k => console.log(k + ':', process.env[k] ? '✓' : '✗'));\"",
    "setup-logger": "npm run replace-logs && npm run fix-syntax && npm run format && npm run lint:fix",
    "clean": "expo r -c && npm run android",
    "clean:ios": "expo r -c && npm run ios",
    "clean:cache": "expo r -c",
    "doctor": "expo doctor",
    "dev-server": "node dev-server/index.js"
  },
  "dependencies": {
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo/cli": "^57.0.34",
    "@expo/config-plugins": "~57.0.0",
    "@expo/metro-config": "~57.0.0",
    "@expo/prebuild-config": "~57.0.0",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@react-navigation/stack": "^7.1.2",
    "@sentry/react-native": "~7.11.0",
    "@types/uuid": "^10.0.0",
    "axios": "^1.18.0",
    "events": "^3.3.0",
    "expo": "^57.0.23",
    "expo-build-properties": "~57.0.17",
    "expo-constants": "~57.0.18",
    "expo-contacts": "~57.0.5",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-navigation-bar": "~57.0.2",
    "expo-notifications": "~57.0.18",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.17",
    "i18n-js": "^4.5.1",
    "i18next": "^24.2.2",
    "lodash": "^4.17.21",
    "react": "19.2.3",
    "react-i18next": "^15.4.1",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-paper": "^5.13.1",
    "react-native-phone-number-input": "^2.1.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "rn-emoji-keyboard": "^1.7.0",
    "semver": "^7.7.1",
    "uuid": "^11.1.0",
